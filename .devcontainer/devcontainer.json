{
  "name": "Ordres de mission — PORTEO GROUP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Aucune infrastructure : base SQLite, e-mails écrits sur disque.
  // Ni PostgreSQL, ni Resend, ni compte à créer.
  "onCreateCommand": "pip install --user -r requirements-dev.txt",
  "updateContentCommand": "python -m scripts.demo --preparer",
  // Le nom du Codespace n'est connu qu'au rattachement : on réaligne alors
  // APP_URL, sans toucher aux données déjà saisies.
  "postAttachCommand": {
    "application": "python -m scripts.demo"
  },

  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Ordres de mission",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "samuelcolvin.jinjahtml"],
      "settings": {
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
