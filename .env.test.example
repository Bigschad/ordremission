# Environnement de la campagne de tests.
#
# Par défaut, aucune variable n'est nécessaire : les tests créent une base
# SQLite temporaire et écrivent les e-mails dans .mailbox/.
#
#     pytest
#
# Pour rejouer la campagne sur PostgreSQL — et notamment le test de
# numérotation concurrente (50 soumissions simultanées), qui vérifie le
# verrouillage de ligne propre à PostgreSQL et reste ignoré sur SQLite :
#
#     TEST_DATABASE_URL="postgresql://om:om@localhost:5432/om_test" pytest
#
TEST_DATABASE_URL="postgresql://om:om@localhost:5432/om_test"

# ---------------------------------------------------------------------------
# Tests de bout en bout (Playwright)
# ---------------------------------------------------------------------------
# Le serveur de test est démarré automatiquement par la fixture `serveur`.
# Ces valeurs ne servent qu'à viser une instance déjà lancée :
#
# E2E_BASE_URL="http://127.0.0.1:5001"
