# ---------------------------------------------------------------------------
# Configuration des tests — à copier en .env.test
#
#   cp .env.test.example .env.test
#
# Ce fichier ne contient aucun secret réel : les tests s'exécutent contre une
# base locale dédiée, jetable, et n'envoient jamais d'e-mail.
# ---------------------------------------------------------------------------

# Base de test dédiée. Les migrations y sont appliquées automatiquement, et les
# tables métier sont vidées entre les suites. Ne jamais pointer vers une base
# contenant des données réelles.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/ordremission_test?sslmode=disable"
DIRECT_URL="postgresql://postgres@127.0.0.1:5432/ordremission_test?sslmode=disable"

# Secret de test, sans valeur en production.
AUTH_SECRET="test-secret-only-remplacez-moi-en-local"
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

RESEND_API_KEY="re_test_key"
EMAIL_FROM="Ordres de mission Porteo <om@porteo-group.com>"
HR_EMAIL="rh@porteo-group.com"

APP_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="Ordres de mission — PORTEO GROUP"

# Court-circuite Resend : les e-mails sont écrits dans .mailbox/, ce qui permet
# aux tests de lire les liens de connexion et de décision.
EMAIL_TRANSPORT="file"
