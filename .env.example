# ---------------------------------------------------------------------------
# Base de données — Neon Postgres (offre gratuite)
# ---------------------------------------------------------------------------
# Chaîne « pooled » (host  ...-pooler.<region>.aws.neon.tech) : utilisée par
# l'application en runtime serverless via @prisma/adapter-neon.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Chaîne directe (sans -pooler) : utilisée uniquement par `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js v5 — magic link
# ---------------------------------------------------------------------------
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://ordres-mission-porteo.vercel.app"
# Nécessaire derrière le proxy Vercel
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# E-mail — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Ordres de mission Porteo <om@porteo-group.com>"
# Une ou plusieurs adresses RH, séparées par des virgules
HR_EMAIL="rh@porteo-group.com"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="https://ordres-mission-porteo.vercel.app"
NEXT_PUBLIC_APP_NAME="Ordres de mission — PORTEO GROUP"

# ---------------------------------------------------------------------------
# Tests uniquement — n'active JAMAIS ceci en production.
# Court-circuite Resend : les e-mails sont écrits dans .mailbox/ au lieu d'être
# envoyés, ce qui permet aux tests Playwright de lire le magic link.
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT="file"
