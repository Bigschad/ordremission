# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Production — Neon Postgres, chaîne « pooled » (hôte ...-pooler...).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# Démonstration et tests — SQLite, aucune infrastructure requise :
# DATABASE_URL="sqlite:///demo.db"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Signe le cookie de session et les jetons CSRF.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""

# URL publique : construit les liens des e-mails et le QR code du PDF.
APP_URL="https://ordres-mission-porteo.vercel.app"
APP_NAME="Ordres de mission — PORTEO GROUP"

# ---------------------------------------------------------------------------
# E-mail — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Ordres de mission Porteo <om@porteo-group.com>"
# Une ou plusieurs adresses RH, séparées par des virgules.
HR_EMAIL="rh@porteo-group.com"

# ---------------------------------------------------------------------------
# Tests et démonstration uniquement — jamais en production.
# « fichier » écrit les e-mails dans .mailbox/ au lieu de les envoyer.
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT="fichier"
# FLASK_DEBUG="1"
