// Schéma Prisma — Ordres de mission PORTEO GROUP
// Base : Neon Postgres. Accès serverless via @prisma/adapter-neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Énumérations métier
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  HR
  ADMIN
}

enum MissionStatus {
  DRAFT // brouillon, non soumis
  SUBMITTED // envoyé aux RH, en attente
  APPROVED // validé RH
  REJECTED // refusé RH
  CANCELLED // annulé par le demandeur avant décision
}

enum TransportType {
  VEHICULE_ETABLISSEMENT
  VEHICULE_PERSONNEL
  VEHICULE_LOCATION
  TRANSPORT_EN_COMMUN
}

// ---------------------------------------------------------------------------
// Utilisateurs & authentification (Auth.js v5 — adapter Prisma)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  nom           String // ex. YEYE
  prenoms       String // ex. SCHADRACH GUY-ROLAND
  matricule     String    @unique // ex. 4071
  fonction      String // ex. Responsable Développement & Intégration IT
  email         String    @unique
  emailVerified DateTime?
  role          Role      @default(EMPLOYEE)
  actif         Boolean   @default(true)

  missions MissionOrder[]
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ordres de mission
// ---------------------------------------------------------------------------

model MissionOrder {
  id          String @id @default(cuid())
  numero      String @unique // OM-2026-0001, attribué à la soumission
  demandeurId String
  demandeur   User   @relation(fields: [demandeurId], references: [id])

  // Identité figée au moment de la soumission (le poste peut changer ensuite)
  nom        String
  prenoms    String
  matricule  String
  fonction   String
  analytique String? // code d'imputation analytique, facultatif

  objet      String // ex. Visite chantier
  lieu       String // ex. Assinie
  dateDepart DateTime // date + heure
  dateRetour DateTime // date + heure

  transportType   TransportType
  transportDetail String? // immatriculation, société de location, ligne…
  litresGasoil    Decimal?      @db.Decimal(6, 2)

  status     MissionStatus @default(DRAFT)
  motifRefus String?

  submittedAt    DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedByName  String? // nom du valideur RH figé
  decidedByEmail String?

  // Compteur de relances « Renvoyer aux RH » (limité à 3)
  relances Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens ApprovalToken[]

  @@index([demandeurId, status])
  @@index([status, submittedAt])
}

model ApprovalToken {
  id             String       @id @default(cuid())
  tokenHash      String       @unique // SHA-256 du token, jamais le token en clair
  missionOrderId String
  missionOrder   MissionOrder @relation(fields: [missionOrderId], references: [id], onDelete: Cascade)
  action         String // "APPROVE" | "REJECT"
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([missionOrderId])
}

// ---------------------------------------------------------------------------
// Journal d'audit
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  entite   String // "MissionOrder"
  entiteId String
  action   String // CREATED, SUBMITTED, APPROVED, REJECTED, CANCELLED, PDF_GENERATED, EMAIL_SENT…
  acteur   String // email ou "SYSTEM"
  ip       String?
  details  Json?

  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Infrastructure : numérotation & rate limiting (sans Redis, tout en base)
// ---------------------------------------------------------------------------

/// Compteur de séquence par année, verrouillé en transaction (SELECT … FOR UPDATE)
/// pour garantir l'unicité du numéro d'ordre de mission sous concurrence.
model Counter {
  annee     Int      @id
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Fenêtre glissante de rate limiting, stockée en base (offre gratuite : pas de Redis).
model RateLimit {
  id           String   @id @default(cuid())
  cle          String // ex. "auth:signin:ip:41.x.x.x"
  fenetreDebut DateTime
  compteur     Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([cle, fenetreDebut])
  @@index([fenetreDebut])
}
